{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    /* Ở Mục 13 thay (localdb) bằng RDS Endpoint tại đây */
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=CloudContactManager;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "AWS": {
    "Profile": "default",
    "Region": "us-east-1"
  },
  "AWS.Logging": {
    "Region": "us-east-1",
    "LogGroup": "/aws/ec2/CloudContactManager/logs",
    "IncludeLogLevel": true,
    "IncludeCategory": true,
    "IncludeNewline": true,
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  }
}