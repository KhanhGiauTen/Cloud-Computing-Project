@{
    ViewData["Title"] = "Send Communication";
}

<h1>Send Communication</h1>

<p>Select customers and send SMS or Email communication.</p>

<!-- TODO: Display list of customers with checkboxes -->
<form asp-action="Send" method="post">
    <div class="form-group">
        <h4>Select Customers:</h4>
        <!-- TODO: Loop through customers and display checkboxes -->
        <!-- 
        @foreach (var customer in Model.Customers)
        {
            <div class="form-check">
                <input type="checkbox" name="CustomerIds" value="@customer.Id" class="form-check-input" />
                <label class="form-check-label">@customer.FullName - @customer.EmailAddress</label>
            </div>
        }
        -->
    </div>

    <div class="form-group mt-3">
        <label>Communication Type:</label>
        <select name="Type" class="form-control">
            <option value="Email">Email</option>
            <option value="SMS">SMS</option>
        </select>
    </div>

    <div class="form-group mt-3">
        <label>Message Content:</label>
        <textarea name="MessageContent" class="form-control" rows="5"></textarea>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Send</button>
</form>
