@model IEnumerable<CloudContactManager.Models.Customer>

@{
    ViewData["Title"] = "Gửi tin nhắn hàng loạt";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-success text-white">
            <h2 class="mb-0"><i class="bi bi-send-fill"></i> Gửi Email/SMS hàng loạt</h2>
        </div>
        <div class="card-body">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (Model != null && Model.Any())
            {
                <form asp-action="Send" method="post" id="communicationForm">
                    @Html.AntiForgeryToken()

                    <!-- Phần chọn khách hàng -->
                    <div class="card mb-4">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <i class="bi bi-people-fill"></i> Chọn khách hàng (Requirement: Selection of individual or multiple customers)
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="form-check mb-3">
                                <input type="checkbox" id="selectAll" class="form-check-input" />
                                <label for="selectAll" class="form-check-label fw-bold">
                                    <i class="bi bi-check-all"></i> Chọn tất cả (@Model.Count() khách hàng)
                                </label>
                            </div>

                            <div class="row">
                                @foreach (var customer in Model)
                                {
                                    <div class="col-md-6 mb-2">
                                        <div class="form-check p-3 border rounded hover-highlight">
                                            <input type="checkbox" 
                                                   name="CustomerIds" 
                                                   value="@customer.Id" 
                                                   class="form-check-input customer-checkbox" 
                                                   id="customer-@customer.Id" />
                                            <label class="form-check-label w-100" for="customer-@customer.Id">
                                                <strong>@customer.FullName</strong><br />
                                                <small class="text-muted">
                                                    <i class="bi bi-envelope"></i> @customer.EmailAddress<br />
                                                    <i class="bi bi-telephone"></i> @customer.PhoneNumber
                                                </small>
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div id="selectedCount" class="alert alert-info mt-3 d-none">
                                <i class="bi bi-info-circle"></i> Đã chọn: <strong><span id="countNumber">0</span></strong> khách hàng
                            </div>
                        </div>
                    </div>

                    <!-- Phần cấu hình tin nhắn -->
                    <div class="card mb-4">
                        <div class="card-header bg-light">
                            <h5 class="mb-0"><i class="bi bi-chat-dots-fill"></i> Nội dung tin nhắn</h5>
                        </div>
                        <div class="card-body">
                            <div class="form-group mb-3">
                                <label for="Type" class="form-label fw-bold">
                                    <i class="bi bi-gear-fill"></i> Loại tin nhắn (AWS SES/SNS):
                                </label>
                                <select name="Type" id="Type" class="form-select" required>
                                    <option value="Email">Email (AWS SES - Simple Email Service)</option>
                                    <option value="SMS">SMS (AWS SNS - Simple Notification Service)</option>
                                </select>
                            </div>

                            <div class="form-group mb-3">
                                <label for="MessageContent" class="form-label fw-bold">
                                    <i class="bi bi-pencil-fill"></i> Nội dung:
                                </label>
                                <textarea name="MessageContent" 
                                          id="MessageContent" 
                                          class="form-control" 
                                          rows="6" 
                                          placeholder="Nhập nội dung tin nhắn hoặc email muốn gửi..." 
                                          required></textarea>
                                <small class="form-text text-muted">
                                    <i class="bi bi-lightbulb"></i> Lưu ý: 
                                    Nội dung sẽ được gửi qua dịch vụ AWS (SES cho Email, SNS cho SMS)
                                </small>
                            </div>
                        </div>
                    </div>

                    <!-- Nút gửi -->
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-controller="Customers" asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Quay lại danh sách
                        </a>
                        <button type="submit" class="btn btn-success btn-lg" id="sendButton">
                            <i class="bi bi-send-fill"></i> Gửi tin nhắn
                        </button>
                    </div>
                </form>
            }
            else
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle"></i> Chưa có khách hàng nào trong hệ thống. 
                    <a asp-controller="Customers" asp-action="Create" class="alert-link">Thêm khách hàng</a> để bắt đầu gửi tin nhắn.
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Select All functionality
        document.getElementById('selectAll')?.addEventListener('change', function() {
            const checkboxes = document.querySelectorAll('.customer-checkbox');
            checkboxes.forEach(cb => cb.checked = this.checked);
            updateSelectedCount();
        });

        // Update count when individual checkbox changes
        document.querySelectorAll('.customer-checkbox').forEach(cb => {
            cb.addEventListener('change', updateSelectedCount);
        });

        // Function to update selected count
        function updateSelectedCount() {
            const checkedBoxes = document.querySelectorAll('.customer-checkbox:checked');
            const count = checkedBoxes.length;
            const countElement = document.getElementById('selectedCount');
            const countNumber = document.getElementById('countNumber');

            if (count > 0) {
                countElement.classList.remove('d-none');
                countNumber.textContent = count;
            } else {
                countElement.classList.add('d-none');
            }
        }

        // Form validation
        document.getElementById('communicationForm')?.addEventListener('submit', function(e) {
            const checkedBoxes = document.querySelectorAll('.customer-checkbox:checked');
            if (checkedBoxes.length === 0) {
                e.preventDefault();
                alert('Vui lòng chọn ít nhất một khách hàng để gửi tin nhắn!');
                return false;
            }
        });
    </script>

    <style>
        .hover-highlight:hover {
            background-color: #f8f9fa;
            cursor: pointer;
        }
    </style>
}
